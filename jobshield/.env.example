# JobShield Environment Configuration
# Obtain your API key from Google AI Studio: https://aistudio.google.com/apikey

# Required: Google Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Optional: Gemini Multimodal Model (Default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.0-flash, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash
