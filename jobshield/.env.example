# JobShield Environment Configuration
# Obtain your API key from Google AI Studio: https://aistudio.google.com/apikey

# Required: Google Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Optional: Gemini Multimodal Model (Default: gemini-3.8-flash)
# Supported options: gemini-3.8-flash, gemini-3.5-flash, gemini-3.1-flash-lite, gemini-flash-latest
GEMINI_MODEL=gemini-3.8-flash
